# Project environment template.
# Copy this file to .env when needed.
# Never commit real secrets.

PROJECT_NAME=surface-defect-detection
ENVIRONMENT=local

# Local paths
DATA_ROOT=data
ARTIFACT_ROOT=artifacts
MLFLOW_TRACKING_URI=mlruns

# Dataset choices
PRIMARY_MVTEC_CATEGORY=bottle
OPTIONAL_MVTEC_CATEGORY=screw

# Optional cloud scaffolding
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_ECR_REPOSITORY=
AWS_EC2_INSTANCE_TYPE=t3.medium

# Optional API scaffolding
API_HOST=0.0.0.0
API_PORT=8000
